# Proveedor de IA: "deepseek", "gemini" o "claude"
PROVEEDOR=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Opcionales si usas Gemini o Claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MODELO_GEMINI=gemini-3.5-flash

# Zona horaria del negocio (opcional, por defecto Colombia)
ZONA_HORARIA=America/Bogota

# WhatsApp Cloud API (Meta) - opcional (sin esto funciona en modo demo web)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Token opcional para proteger GET /citas con header Authorization: Bearer <token>
ADMIN_TOKEN=
